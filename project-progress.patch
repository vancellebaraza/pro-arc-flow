+  "Awaiting quotation",
+  "Awaiting funds",
+  "Work in progress",
+  "Complete fully paid",
+  "Complete with balance",
+] as const;
+
+export type ProgressCategory = (typeof PROGRESS_CATEGORIES)[number];
